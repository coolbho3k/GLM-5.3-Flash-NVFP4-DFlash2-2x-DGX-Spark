ARG BASE_IMAGE=glm53-exl3:prefill-pipeline-v1
FROM ${BASE_IMAGE}
COPY probes/build_exl3_fat_pipeline.py probes/build_exl3_fat_norepack.py /opt/glm53/
COPY vendor/miaai-exl3/patch_exl3_fat_norepack.py overlay-exl3-fp8/rebuild_exl3_extension.py /opt/glm53/
ENV TORCH_CUDA_ARCH_LIST=12.1a MAX_JOBS=2
RUN python3 /opt/glm53/patch_exl3_fat_norepack.py /usr/local/lib/python3.12/dist-packages/exllamav3/exllamav3_ext && python3 /opt/glm53/rebuild_exl3_extension.py
COPY vendor/miaai-exl3/exl3.py /usr/local/lib/python3.12/dist-packages/vllm/model_executor/layers/quantization/exl3.py
RUN python3 -m py_compile /usr/local/lib/python3.12/dist-packages/vllm/model_executor/layers/quantization/exl3.py && python3 -c "import torch; import exllamav3_ext as e; assert e.glm53_fat_pipeline_version() == 2; assert e.glm53_fat_norepack_version() == 1"
