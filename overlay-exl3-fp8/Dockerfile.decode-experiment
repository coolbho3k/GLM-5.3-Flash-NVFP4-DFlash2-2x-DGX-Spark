ARG BASE_IMAGE=glm53-exl3:e2-activation-v2
FROM ${BASE_IMAGE}
COPY vendor/miaai-exl3/patch_exl3_decode_pipeline.py /opt/glm53/
COPY overlay-exl3-fp8/rebuild_exl3_extension.py /opt/glm53/
ENV TORCH_CUDA_ARCH_LIST=12.1a MAX_JOBS=4
RUN python3 /opt/glm53/patch_exl3_decode_pipeline.py /usr/local/lib/python3.12/dist-packages/exllamav3/exllamav3_ext && python3 /opt/glm53/rebuild_exl3_extension.py
COPY vendor/miaai-exl3/exl3.py /usr/local/lib/python3.12/dist-packages/vllm/model_executor/layers/quantization/exl3.py
RUN python3 -m py_compile /usr/local/lib/python3.12/dist-packages/vllm/model_executor/layers/quantization/exl3.py && python3 -c "import torch; import exllamav3_ext as e; assert e.glm53_fast_moe_version() == 1"
