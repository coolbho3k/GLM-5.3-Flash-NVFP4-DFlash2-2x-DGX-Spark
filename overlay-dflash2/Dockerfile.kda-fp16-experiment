ARG BASE_IMAGE=glm53-v11:nvfp4-dcp2-exp19
FROM ${BASE_IMAGE}

COPY overlay-dflash2/patch_vllm_kda_fp16_state.py /tmp/patch_vllm_kda_fp16_state.py

RUN python3 /tmp/patch_vllm_kda_fp16_state.py && \
    python3 -m py_compile \
      /usr/local/lib/python3.12/dist-packages/vllm/model_executor/layers/mamba/mamba_utils.py \
      /usr/local/lib/python3.12/dist-packages/vllm/platforms/interface.py
