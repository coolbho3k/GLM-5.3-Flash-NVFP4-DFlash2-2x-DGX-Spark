# Add native block-FP8 passthrough support to the known-good serving image.
ARG BASE_IMAGE=glm53-v11:kvopt-final
FROM ${BASE_IMAGE}

COPY overlay-dflash2/patch_vllm_glm_ct_fp8_passthrough.py \
     /tmp/patch_vllm_glm_ct_fp8_passthrough.py
RUN python3 /tmp/patch_vllm_glm_ct_fp8_passthrough.py && \
    rm /tmp/patch_vllm_glm_ct_fp8_passthrough.py && \
    python3 -m py_compile \
      /usr/local/lib/python3.12/dist-packages/vllm/models/glm5next/nvidia/model.py \
      /usr/local/lib/python3.12/dist-packages/vllm/model_executor/layers/quantization/compressed_tensors/compressed_tensors.py
